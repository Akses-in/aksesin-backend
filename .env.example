NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Copy the Supabase Connect > Session pooler URI (port 5432).
# URL-encode special characters in the database password.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full"
# Use the session pooler or direct connection for Prisma CLI migrations.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full"

# WhatsApp registration
# FONNTE_TOKEN=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# OSM place import (optional). Comma-separated HTTPS Overpass endpoints, tried in order.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
